      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Scheduler lag p50 / p95",
      "description": "How late probes start relative to their schedule. Rising lag means the worker pool is saturated.",
