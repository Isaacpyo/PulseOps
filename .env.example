# PulseOps environment variables. Copy to .env for docker compose, or set them
# in Render (API) / Netlify (web). Never commit real secrets.

# ---------------------------------------------------------------- API (apps/api)
# Postgres connection string. Neon: use the pooled URL with sslmode=require.
DATABASE_URL=postgres://pulseops:pulseops@localhost:5432/pulseops?sslmode=disable
# HTTP port (Render injects this automatically).
PORT=8080
# Comma-separated browser origins allowed to call the API (the web console).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Console base URL, used for links inside Slack notifications.
PUBLIC_APP_URL=http://localhost:5173
# Read the client IP from X-Forwarded-For (only behind a trusted proxy, e.g. Render).
TRUST_PROXY_HEADERS=false
# debug | info | warn | error
LOG_LEVEL=info
# Bearer session lifetime for regular accounts (demo sessions last 24h).
SESSION_TTL=168h

# Run the probe scheduler + worker pool in this process.
SCHEDULER_ENABLED=true
# Concurrent probes per instance.
WORKER_CONCURRENCY=8
# Allow probing loopback/private/link-local targets. Keep false on the internet (SSRF).
ALLOW_PRIVATE_TARGETS=false
# Days of raw probe results to keep (daily rollups are kept for 100 days).
RESULT_RETENTION_DAYS=7
# Abuse guard: maximum checks per workspace.
MAX_CHECKS_PER_WORKSPACE=25

# Alert delivery: "mock" records alerts in the notification log only;
# "slack" posts to the workspace webhook (set in Settings) or SLACK_WEBHOOK_URL.
NOTIFIER=mock
# Default Slack incoming webhook (https://hooks.slack.com/services/...). Secret.
SLACK_WEBHOOK_URL=

# Seed the shared demo workspace and enable POST /api/auth/demo.
DEMO_ENABLED=true
# Wipe and re-seed the demo workspace on every boot (keeps the live demo clean).
DEMO_RESET_ON_BOOT=false

# Optional bearer token protecting GET /metrics. Secret.
METRICS_TOKEN=

# Grafana Cloud (or any Prometheus remote_write endpoint). Leave empty to disable.
# e.g. https://prometheus-prod-XX-prod-eu-west-2.grafana.net/api/prom/push
REMOTE_WRITE_URL=
# Grafana Cloud Prometheus instance ID (numeric username).
REMOTE_WRITE_USERNAME=
# Grafana Cloud access policy token with metrics:write scope. Secret.
REMOTE_WRITE_PASSWORD=
# Push interval.
REMOTE_WRITE_INTERVAL=30s

# ---------------------------------------------------------------- Web (apps/web)
# API base URL, inlined at build time by Vite.
VITE_API_URL=http://localhost:8080

# ---------------------------------------------------------------- docker compose
POSTGRES_PASSWORD=pulseops
GRAFANA_ADMIN_PASSWORD=admin
